{
  "id": "cpp",
  "name": "C++",
  "caseSensitive": true,
  "highlight": {
    "comment": "\\/\\/[^\\n]*",
    "string": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
    "number": "\\b\\d+(?:\\.\\d+)?\\b",
    "keywords": ["int","double","bool","if","else","while","for","return","true","false","break","continue","std","cout","cin","endl","string","nullptr"]
  },
  "codegen": {
    "indent": "    ",
    "statementEnd": ";",
    "types": { "int": "int", "double": "double", "boolean": "bool", "String": "std::string" },
    "literals": { "true": "true", "false": "false" },
    "templates": {
      "declare":   ["{type} {name} = {value}{end}"],
      "assign":    ["{name} = {value}{end}"],
      "output":    ["std::cout << {value} << std::endl{end}"],
      "input":     ["std::cin >> {name}{end}"],
      "if":        ["if ({cond}) {", "{body}", "}"],
      "ifElse":    ["if ({cond}) {", "{body}", "} else {", "{else_body}", "}"],
      "while":     ["while ({cond}) {", "{body}", "}"],
      "for":       ["for (int {var} = {from}; {var} <= {to}; {incr}) {", "{body}", "}"],
      "comment":   ["// {text}"],
      "break":     ["break{end}"],
      "continue":  ["continue{end}"],
      "emptyBody": ["// empty"]
    }
  }
}