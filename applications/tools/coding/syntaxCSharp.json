{
  "id": "cs",
  "name": "C#",
  "caseSensitive": true,
  "highlight": {
    "comment": "\\/\\/[^\\n]*",
    "string": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
    "number": "\\b\\d+(?:\\.\\d+)?\\b",
    "keywords": ["int","double","bool","string","if","else","while","for","public","static","void","class","new","return","true","false","break","continue","Console","WriteLine","ReadLine","null"]
  },
  "codegen": {
    "indent": "    ",
    "statementEnd": ";",
    "types": { "int": "int", "double": "double", "boolean": "bool", "String": "string" },
    "literals": { "true": "true", "false": "false" },
    "templates": {
      "declare":   ["{type} {name} = {value}{end}"],
      "assign":    ["{name} = {value}{end}"],
      "output":    ["Console.WriteLine({value}){end}"],
      "input":     ["{name} = Console.ReadLine(){end}"],
      "if":        ["if ({cond}) {", "{body}", "}"],
      "ifElse":    ["if ({cond}) {", "{body}", "} else {", "{else_body}", "}"],
      "while":     ["while ({cond}) {", "{body}", "}"],
      "for":       ["for (int {var} = {from}; {var} <= {to}; {incr}) {", "{body}", "}"],
      "comment":   ["// {text}"],
      "break":     ["break{end}"],
      "continue":  ["continue{end}"],
      "emptyBody": ["// empty"]
    }
  }
}