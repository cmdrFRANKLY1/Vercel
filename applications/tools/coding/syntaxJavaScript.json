{
  "id": "js",
  "name": "JavaScript",
  "caseSensitive": true,
  "highlight": {
    "comment": "\\/\\/[^\\n]*",
    "string": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|`(?:[^`\\\\]|\\\\.)*`",
    "number": "\\b\\d+(?:\\.\\d+)?\\b",
    "keywords": ["let","const","var","if","else","while","for","function","return","console","log","prompt","true","false","break","continue","null"]
  },
  "codegen": {
    "indent": "    ",
    "statementEnd": ";",
    "types": {},
    "literals": { "true": "true", "false": "false" },
    "templates": {
      "declare":   ["let {name} = {value}{end}"],
      "assign":    ["{name} = {value}{end}"],
      "output":    ["console.log({value}){end}"],
      "input":     ["let {name} = prompt(\"{prompt}\"){end}"],
      "if":        ["if ({cond}) {", "{body}", "}"],
      "ifElse":    ["if ({cond}) {", "{body}", "} else {", "{else_body}", "}"],
      "while":     ["while ({cond}) {", "{body}", "}"],
      "for":       ["for (let {var} = {from}; {var} <= {to}; {incr}) {", "{body}", "}"],
      "comment":   ["// {text}"],
      "break":     ["break{end}"],
      "continue":  ["continue{end}"],
      "emptyBody": ["// empty"]
    }
  }
}