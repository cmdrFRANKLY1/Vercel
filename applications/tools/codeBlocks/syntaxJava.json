{
  "id": "java",
  "name": "Java",
  "caseSensitive": true,
  "highlight": {
    "comment": "\\/\\/[^\\n]*",
    "string": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
    "number": "\\b\\d+(?:\\.\\d+)?\\b",
    "keywords": ["int","double","boolean","String","if","else","while","for","public","static","void","class","new","return","true","false","break","continue","System","out","println","null"]
  },
  "codegen": {
    "indent": "    ",
    "statementEnd": ";",
    "types": { "int": "int", "double": "double", "boolean": "boolean", "String": "String" },
    "literals": { "true": "true", "false": "false" },
    "templates": {
      "declare":   ["{type} {name} = {value}{end}"],
      "assign":    ["{name} = {value}{end}"],
      "output":    ["System.out.println({value}){end}"],
      "input":     ["{name} = scanner.nextLine(){end}"],
      "if":        ["if ({cond}) {", "{body}", "}"],
      "ifElse":    ["if ({cond}) {", "{body}", "} else {", "{else_body}", "}"],
      "while":     ["while ({cond}) {", "{body}", "}"],
      "for":       ["for (int {var} = {from}; {var} <= {to}; {incr}) {", "{body}", "}"],
      "comment":   ["// {text}"],
      "break":     ["break{end}"],
      "continue":  ["continue{end}"],
      "emptyBody": ["// empty"]
    }
  }
}