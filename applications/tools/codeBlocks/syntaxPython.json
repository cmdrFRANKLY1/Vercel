{
  "id": "python",
  "name": "Python",
  "caseSensitive": true,
  "highlight": {
    "comment": "#[^\\n]*",
    "string": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
    "number": "\\b\\d+(?:\\.\\d+)?\\b",
    "keywords": ["if","elif","else","while","for","in","range","print","input","break","continue","True","False","and","or","not","def","return","None"]
  },
  "codegen": {
    "indent": "    ",
    "statementEnd": "",
    "types": {},
    "literals": { "true": "True", "false": "False" },
    "templates": {
      "declare":   ["{name} = {value}"],
      "assign":    ["{name} = {value}"],
      "output":    ["print({value})"],
      "input":     ["{name} = input(\"{prompt}\")"],
      "if":        ["if {cond}:", "{body}"],
      "ifElse":    ["if {cond}:", "{body}", "else:", "{else_body}"],
      "while":     ["while {cond}:", "{body}"],
      "for":       ["for {var} in range({from}, {to_exclusive}{step_arg}):", "{body}"],
      "comment":   ["# {text}"],
      "break":     ["break"],
      "continue":  ["continue"],
      "emptyBody": ["pass"]
    }
  }
}