{
  "id": "pseudo",
  "name": "Pseudocode",
  "caseSensitive": false,
  "highlight": {
    "comment": null,
    "string": "\"(?:[^\"\\\\]|\\\\.)*\"",
    "number": "\\b\\d+(?:\\.\\d+)?\\b",
    "keywords": ["WENN","DANN","SONST","ENDE","SOLANGE","WIEDERHOLE","FÜR","VON","BIS","SCHRITT","SETZE","AUSGABE","EINGABE","ABBRECHEN","FORTSETZEN","WAHR","FALSCH"]
  },
  "codegen": {
    "indent": "    ",
    "statementEnd": "",
    "types": {},
    "literals": { "true": "WAHR", "false": "FALSCH" },
    "templates": {
      "declare":   ["SETZE {name} = {value}"],
      "assign":    ["SETZE {name} = {value}"],
      "output":    ["AUSGABE {value}"],
      "input":     ["EINGABE {name}"],
      "if":        ["WENN {cond} DANN", "{body}", "ENDE WENN"],
      "ifElse":    ["WENN {cond} DANN", "{body}", "SONST", "{else_body}", "ENDE WENN"],
      "while":     ["SOLANGE {cond} WIEDERHOLE", "{body}", "ENDE SOLANGE"],
      "for":       ["FÜR {var} VON {from} BIS {to} SCHRITT {step}", "{body}", "ENDE FÜR"],
      "comment":   ["# {text}"],
      "break":     ["ABBRECHEN"],
      "continue":  ["FORTSETZEN"],
      "emptyBody": ["..."]
    }
  }
}